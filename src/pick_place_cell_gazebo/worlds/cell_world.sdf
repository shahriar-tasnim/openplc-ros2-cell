<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="cell_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- SUN -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- FLOOR -->

    <model name="factory_floor">

      <static>true</static>

      <link name="floor_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4 4 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 4 0.1</size>
            </box>
          </geometry>

          <material>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>

      </link>

    </model>

    <!-- CONVEYOR -->

    <model name="conveyor">

      <static>true</static>

      <pose>0.75 -0.55 0.15 0 0 0</pose>

      <link name="conveyor_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.28 0.20</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.28 0.20</size>
            </box>
          </geometry>

          <material>
            <diffuse>0.10 0.10 0.10 1</diffuse>
          </material>
        </visual>

      </link>

    </model>

    <!-- PART -->

    <model name="part">

      <pose>1.35 -0.55 0.31 0 0 0</pose>

      <link name="part_link">

        <inertial>
          <mass>0.20</mass>

          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>

          <material>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>

      </link>

    </model>

    <!-- DESTINATION BIN -->

    <model name="place_bin">

      <static>true</static>

      <pose>0.65 0.65 0.15 0 0 0</pose>

      <link name="bin_link">

        <visual name="bottom">
          <geometry>
            <box>
              <size>0.45 0.45 0.08</size>
            </box>
          </geometry>

          <material>
            <diffuse>0.1 0.55 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="bottom_collision">
          <geometry>
            <box>
              <size>0.45 0.45 0.08</size>
            </box>
          </geometry>
        </collision>

      </link>

    </model>

  </world>

</sdf>
