<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="cell_robot">

  <!-- =========================================================
       6-DOF industrial-style arm for the pick-and-place cell.
       Kinematics validated against the cell world:
         PICK  (0.75, -0.55, 0.31)   PLACE (0.65, 0.65, 0.30)
       Layout: J1 base yaw, J2 shoulder pitch, J3 elbow pitch,
               J4 wrist roll, J5 wrist pitch, J6 tool roll.
       ========================================================= -->

  <!-- ================= MATERIALS ================= -->
  <material name="blue">   <color rgba="0.1 0.3 0.8 1"/></material>
  <material name="dark">   <color rgba="0.15 0.15 0.15 1"/></material>
  <material name="silver"> <color rgba="0.65 0.65 0.65 1"/></material>

  <!-- ================= WORLD ================= -->
  <link name="world"/>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><cylinder radius="0.13" length="0.40"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20"/>
      <geometry><cylinder radius="0.13" length="0.40"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="6.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ================= J1 : BASE YAW (Z) ================= -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.16 0.16 0.14"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.16 0.16 0.14"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="2.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.40"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="1.5"/>
  </joint>

  <!-- ================= J2 : SHOULDER PITCH (Y) ================= -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.275 0 0"/>
      <geometry><box size="0.55 0.10 0.10"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.275 0 0"/>
      <geometry><box size="0.55 0.10 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.275 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.052" iyz="0" izz="0.052"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.9" upper="1.9" effort="150" velocity="1.5"/>
  </joint>

  <!-- ================= J3 : ELBOW PITCH (Y) ================= -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0.26 0 0"/>
      <geometry><box size="0.52 0.08 0.08"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.26 0 0"/>
      <geometry><box size="0.52 0.08 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.26 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.035" iyz="0" izz="0.035"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.55 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="100" velocity="1.5"/>
  </joint>

  <!-- ================= J4 : WRIST ROLL (X) ================= -->
  <link name="wrist1_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.07 0.07"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.07 0.07"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/><child link="wrist1_link"/>
    <origin xyz="0.52 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="40" velocity="2.0"/>
  </joint>

  <!-- ================= J5 : WRIST PITCH (Y) ================= -->
  <link name="wrist2_link">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.07 0.07"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.07 0.07"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="wrist1_link"/><child link="wrist2_link"/>
    <origin xyz="0.10 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="40" velocity="2.0"/>
  </joint>

  <!-- ================= J6 : TOOL ROLL (X) ================= -->
  <link name="tool_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.09 0.06"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.09 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="wrist2_link"/><child link="tool_link"/>
    <origin xyz="0.08 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="40" velocity="2.0"/>
  </joint>

  <!-- ================= GRIPPER FINGERS ================= -->
  <!-- Fingers extend along +X (the approach axis) and straddle the
       0.08 m cube in Y. Grasp center = tcp_link below. -->
  <link name="left_finger">
    <visual>
      <origin xyz="0.05 0.05 0"/>
      <geometry><box size="0.10 0.02 0.08"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0.05 0"/>
      <geometry><box size="0.10 0.02 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0.05 0"/><mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <joint name="left_finger_fixed" type="fixed">
    <parent link="tool_link"/><child link="left_finger"/>
    <origin xyz="0.10 0 0"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0.05 -0.05 0"/>
      <geometry><box size="0.10 0.02 0.08"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 -0.05 0"/>
      <geometry><box size="0.10 0.02 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 -0.05 0"/><mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <joint name="right_finger_fixed" type="fixed">
    <parent link="tool_link"/><child link="right_finger"/>
    <origin xyz="0.10 0 0"/>
  </joint>

  <!-- Tool Center Point: grasp target used by the IK solver.
       0.12 m along the approach axis from the tool flange. -->
  <link name="tcp_link"/>
  <joint name="tool_to_tcp" type="fixed">
    <parent link="tool_link"/><child link="tcp_link"/>
    <origin xyz="0.12 0 0"/>
  </joint>

  <!-- ================= ROS2 CONTROL ================= -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find pick_place_cell_gazebo)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
